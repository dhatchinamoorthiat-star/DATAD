{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "client",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "client"],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "client-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "preview", "--prefix", "client", "--", "--port", "4174"],
      "port": 4174,
      "autoPort": true
    },
    {
      "name": "server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "server"],
      "port": 5001,
      "autoPort": true
    },
    {
      "name": "server-testdb",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "VERIFY_CLIENT_ORIGINS=http://localhost:5174,http://localhost:5175,http://localhost:5176 node server/verify-testdb-server.js"
      ],
      "port": 5001,
      "autoPort": true
    }
  ]
}
