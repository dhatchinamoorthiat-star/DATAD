node_modules/
dist/
# Every .env variant, not just `.env` — a `.env.bak`, `.env.local` or a dated
# copy made while debugging carries exactly the same live secrets, and a bare
# `.env` rule silently lets those through to `git add -A`.
.env
.env.*
!.env.example
# client/.env.native is build config, not credentials: one public API origin,
# inlined into the bundle by `npm run build:native` and therefore shipped inside
# every store binary anyway. It has to be committed — untracked, a fresh clone
# or a CI runner builds an app whose API base falls back to the same-origin
# `/api`, which in the native shell points at the WebView itself. Every request
# 404s, and only on device. Narrow negation on purpose; the blanket rule above
# still catches .env.local and friends.
!client/.env.native
.DS_Store
audit/
.claude/worktrees/

# Generated knowledge-graph output (~173 MB across the three copies). Rebuilt
# from source by `graphify update`, so committing it adds size without adding
# information — and would put the repo past GitHub's size warnings.
graphify-out/

# Vendored second project. odysseus/ has its own .git directory, so adding it
# here would create a broken gitlink rather than committing its contents.
odysseus/

# Local tooling state
.wrangler/

# Working backups. Keeping these out of history is what stops a stale copy
# being edited by mistake months later.
*.bak
*.backup
*.notifications-backup
backups/
*.zip

# Credential bundle written by `node scripts/datad.mjs export`. Contains live
# Mongo, Brevo and Cloudinary credentials — must never reach the repo.
datad-secrets.bundle.json

# Per-machine Claude Code settings. settings.json is the shared, committed
# config; the .local.json sibling holds one developer's own permission grants
# and would churn on every machine.
**/.claude/settings.local.json

# Throwaway one-off scripts (e.g. server/verify_user.tmp.js) — some of these
# connect to a real database, so they must never be committed by accident.
*.tmp.js
