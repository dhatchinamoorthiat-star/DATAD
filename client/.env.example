# Relative /api works everywhere (Vite proxy in dev, same-origin in prod/ngrok).
# Set a full URL only if the API lives on a different domain.
VITE_API_BASE_URL=/api

# Sentry DSN for client-side crash reporting (optional — omit to disable).
# VITE_SENTRY_DSN=https://example@o0.ingest.sentry.io/0

# Pitch mode: shows only the 6 stall-pitch modules (Planner, Resume/Career,
# Daily Briefing, Finance, Campus Hub, Dax + Wellbeing) and hides the rest.
# Set true on the stall demo build only; leave unset/false everywhere else.
# VITE_PITCH_MODE=true
