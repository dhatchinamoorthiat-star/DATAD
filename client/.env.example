# Relative /api works everywhere (Vite proxy in dev, same-origin in prod/ngrok).
# Set a full URL only if the API lives on a different domain.
VITE_API_BASE_URL=/api

# Sentry DSN for client-side crash reporting (optional — omit to disable).
# VITE_SENTRY_DSN=https://example@o0.ingest.sentry.io/0

# UPI payee shown on the subscription checkout QR (components/subscription/
# CheckoutSummary.jsx). Falls back to datad@upi / DATAD when unset — set both
# in production so students pay the real account.
VITE_UPI_VPA=<your-upi-vpa>
VITE_UPI_NAME=DATAD
