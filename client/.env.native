# Build-time config for the Capacitor native builds only: `npm run build:native`
# selects this file via Vite's `--mode native`. The web deploy on Render never
# reads it, so the same-origin `/api` default in src/api/axios.js is untouched.
#
# Absolute and required here. In the shell the bundle is served from the app's
# own local origin (https://localhost on Android, capacitor://localhost on iOS),
# so a relative `/api` resolves to the WebView itself and every call 404s
# against the app's own asset server. There is no same origin to be relative to.
#
# This origin must also be allowed through CORS by the server — see
# NATIVE_APP_ORIGINS in server/utils/clientUrl.js.
VITE_API_BASE_URL=https://datad.online/api
