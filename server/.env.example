PORT=5001
# Public origin of the deployed frontend. Used for CORS, cookie scope, and the
# links inside verification/reset emails — a wrong value silently breaks signup.
# Production: the real https origin, no trailing slash. Local dev: http://localhost:5173
CLIENT_URL=https://yourdomain.com
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/datad?retryWrites=true&w=majority
JWT_SECRET=<long-random-string>
CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>
# ── Mail (see config/mailTransport.js) ────────────────────────────────────────
# Registration gates on an email-verification link, so a server with no mail
# transport cannot accept new users. Configure exactly one of the three blocks
# below; they are tried in this order.
#
# 1. Brevo — PREFERRED for production. Gmail SMTP caps out around 500
#    recipients/day, which stops signups platform-wide once reached.
#    BREVO_FROM_EMAIL must be on a domain verified in your Brevo account.
#
#    Brevo issues two different, non-interchangeable credentials. Set either:
#      BREVO_API_KEY       "xkeysib-…"   HTTP API (preferred)
#      BREVO_SMTP_API_KEY  "xsmtpsib-…"  SMTP relay on smtp-relay.brevo.com
# BREVO_API_KEY=<brevo-http-api-key>
# BREVO_FROM_EMAIL=no-reply@yourdomain.com
# BREVO_FROM_NAME=DATAD
#
# 2. Any other SMTP provider (Postmark, SES, Mailgun…). For Brevo's own relay
#    use BREVO_SMTP_API_KEY above instead of these.
# SMTP_HOST=<smtp-host>
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=<smtp-username>
# SMTP_PASS=<smtp-password>
#
# 3. Gmail SMTP — development and low volume only. GMAIL_APP_PASSWORD is a
#    Google App Password (needs 2-Step Verification on), NOT the account password.
GMAIL_USER=<sending-gmail-address>
GMAIL_APP_PASSWORD=<16-char-google-app-password>

ADMIN_EMAIL=<the-admin-superuser-email>

# Optional: override the DNS resolver. Only for local networks that fail to
# resolve Atlas SRV records — never set this in a managed host, where it
# breaks the platform's internal DNS. Applied by the server and by the
# integration test suites, which need the same SRV lookup to reach Atlas.
# DNS_SERVERS=8.8.8.8,8.8.4.4

# Optional: log verbosity — error | warn | info | debug.
# Defaults to `info` in production and `debug` everywhere else. Raise to debug
# in production only while investigating something: the AI and notification
# paths are the noisiest callers.
# LOG_LEVEL=info
# ── AI providers ──────────────────────────────────────────────────────────────
# Primary provider — NVIDIA NIM (set at least this key)
NVIDIA_API_KEY=<nvidia-nim-api-key>
# Standby keys from separate free-tier NVIDIA accounts. They stay unused
# until the primary fails (429 rate limit / exhausted credits / 401 revoked /
# NVIDIA 5xx outage), then requests move to the next key automatically and
# drift back to the primary after 5 minutes. Add as many as you like.
NVIDIA_API_KEY_2=
NVIDIA_API_KEY_3=
NVIDIA_MODEL=

# Local fallback (no key needed) — a machine-local Ollama daemon. Leave this
# UNSET in production: there is no localhost:11434 on a managed host, and when
# unset the provider is skipped entirely instead of failing on every call.
# Uncomment for local development only.
# OLLAMA_BASE_URL=http://localhost:11434

# Legacy providers (preserved for backward compatibility)
GROQ_API_KEY=
GROQ_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Which provider to use first and as fallback.
# In production the fallback must be a hosted provider whose key is set above
# (the NVIDIA standby keys already cover primary failure). `ollama` is a
# development-only fallback and needs OLLAMA_BASE_URL.
AI_PRIMARY_PROVIDER=nvidia
AI_FALLBACK_PROVIDER=groq

# ── AI automation thresholds ──────────────────────────────────────────────────
# Content with confidence >= AUTO_PUBLISH is published immediately; below MINIMUM is discarded
AI_CONFIDENCE_AUTO_PUBLISH=0.75
AI_CONFIDENCE_MINIMUM=0.4
MODERATION_HIDE_THRESHOLD=0.85
MODERATION_BATCH_SIZE=20

# ── Cron schedule overrides (node-cron format, optional) ──────────────────────
# CRON_DAILY_CASE=0 5 * * *
# CRON_DAILY_BRIEFING=0 6 * * *
# CRON_DAILY_REFLECTION=15 6 * * *
# CRON_RESUME_TIP=0 7 * * *
# CRON_COMPANY_REFRESH=0 2 * * *
# CRON_INTERVIEW_QUESTIONS=0 4 * * 0
# CRON_NEWSLETTER=0 8 * * 0
# CRON_NEWS_REFRESH=*/30 * * * *
# CRON_MARKET_REFRESH=*/15 * * * *
# CRON_MODERATION=*/10 * * * *

# ── Resume tip deduplication window ──────────────────────────────────────────
RESUME_TIP_DEDUP_DAYS=60

# ── AI Orchestration Platform (Phase 2-12) ───────────────────────────────────

# Semantic search — uses OpenAI text-embedding-3-small when key is set,
# falls back to a zero-dependency hash-based vector otherwise
# OPENAI_API_KEY already covers embeddings — no extra key needed

# Model routing tiers (override defaults from ai/router.js if needed)
# AI_FAST_PROVIDER=groq          # cheap summarization
# AI_BALANCED_PROVIDER=openai    # structured JSON tasks
# AI_POWERFUL_PROVIDER=anthropic # complex reasoning

# AI retry tuning
AI_RETRY_ATTEMPTS=3
AI_RETRY_DELAY_MS=2000

# News content age ceiling (days before pruning)
NEWS_MAX_AGE_DAYS=21
# ── Subscription / UPI ────────────────────────────────────────────────────────
# These are read by the CLIENT as VITE_ vars — put the same values in client/.env
# UPI VPA and display name shown on the payment QR
# (Set in client/.env as VITE_UPI_VPA and VITE_UPI_NAME)

# Content Studio (centralized publishing). Set to false to disable.
STUDIO_ENABLED=true

# ── Observability / error tracking ────────────────────────────────────────────
# Every 500, every crash and every frontend runtime error funnels through
# observability/errorTracker.js. With neither variable below set, the only sink
# is the structured log — which means nobody is alerted, and the first you hear
# of an outage is a student telling you. Set at least one in production.
#
# Sentry. @sentry/node is installed, so the DSN is all that is needed.
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
#
# Or a plain JSON POST — Slack/Discord incoming webhook, or anything else.
# Free, and enough to get an alert.
# ERROR_WEBHOOK_URL=https://hooks.slack.com/services/...
#
# Tags events with the deployed commit so an issue points at a diff.
# Render sets RENDER_GIT_COMMIT automatically; set APP_VERSION elsewhere.
# APP_VERSION=
#
# Verify it actually reaches a human — run against the deployed environment:
#   npm run verify:errors
