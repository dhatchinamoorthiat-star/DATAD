{
  "name": "datad-server",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --forceExit --detectOpenHandles",
    "verify:errors": "node scripts/verifyErrorTracking.js",
    "test:integration": "ALLOW_REAL_EXTERNAL_CALLS=1 node --experimental-vm-modules ./node_modules/jest/bin/jest.js --forceExit --detectOpenHandles"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@sentry/node": "^10.70.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.4",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.3",
    "openai": "^6.46.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.19.1",
    "rss-parser": "^3.13.0",
    "uuid": "^14.0.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "^3.1.14"
  },
  "jest": {
    "moduleNameMapper": {
      "^uuid$": "<rootDir>/tests/__mocks__/uuid.js"
    },
    "testTimeout": 30000,
    "setupFiles": [
      "<rootDir>/tests/setup/safeEnv.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup/blockExternalCalls.js",
      "<rootDir>/tests/socketGuard.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/setup/"
    ]
  }
}
